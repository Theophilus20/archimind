# Copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web app.
# Without these values ArchiMind runs in demo mode: everything works, AI requests fall back to
# deterministic heuristics and are labelled "Heuristic" in the AI activity log.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: only if your Realtime Database URL isn't https://<project-id>-default-rtdb.firebaseio.com
VITE_FIREBASE_DATABASE_URL=
# Optional: enables Google Analytics events
VITE_FIREBASE_MEASUREMENT_ID=

# App Check (required by Firebase AI Logic). Use a reCAPTCHA Enterprise site key.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# For local development set to "true" and register the debug token printed in the console,
# or paste a registered debug token here. Never commit a real token.
VITE_APPCHECK_DEBUG_TOKEN=

# Optional: override the cloud model (defaults to the SDK default).
VITE_CLOUD_MODEL=

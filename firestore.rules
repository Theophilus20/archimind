rules_version = '2';

// ArchiMind Firestore rules — project membership with role-scoped invite links.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function isMemberOf(data) {
      return signedIn() && uid() in data.memberUids;
    }
    function projectMember(pid) {
      return isMemberOf(get(/databases/$(database)/documents/projects/$(pid)).data);
    }
    // Access level: 'crit' (crit room only), 'markup' (crit room + mark-up) or 'full'.
    function accessOf(data) {
      return data.get('access', {}).get(uid(), 'full');
    }
    function isFullMember(data) {
      return isMemberOf(data) && (data.owner == uid() || accessOf(data) == 'full');
    }
    function projectFullMember(pid) {
      return isFullMember(get(/databases/$(database)/documents/projects/$(pid)).data);
    }
    function projectOwner(pid) {
      let p = get(/databases/$(database)/documents/projects/$(pid)).data;
      return signedIn() && (p.get('owner', '') == uid() || p.get('owner', '') == '');
    }
    // The owner is deleting the whole project (account deletion): everything inside may be removed.
    function ownerDeleting(pid) {
      let p = get(/databases/$(database)/documents/projects/$(pid)).data;
      return signedIn() && p.owner == uid() && p.get('deleting', false) == true;
    }
    // Keep documents comfortably under Firestore's 1 MiB limit.
    function reasonableSize() {
      return request.resource.size() < 900000;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && uid() == userId;
    }

    match /invites/{code} {
      allow read: if signedIn();
      allow create: if projectFullMember(request.resource.data.projectId)
        && request.resource.data.createdBy == uid()
        && request.resource.data.role in ['student', 'lecturer', 'architect', 'client']
        && request.resource.data.get('access', 'full') in ['crit', 'markup', 'full'];
      allow delete: if signedIn() && resource.data.createdBy == uid();
      allow update: if false;
    }

    match /projects/{projectId} {
      // Reading a project that doesn't exist yet is allowed so a client can create it.
      allow get: if signedIn() && (resource == null || isMemberOf(resource.data));
      // "My projects" query: where('memberUids', 'array-contains', uid) satisfies this rule.
      allow list: if signedIn() && uid() in resource.data.memberUids;

      allow create: if signedIn()
        && request.resource.data.owner == uid()
        && request.resource.data.memberUids == [uid()]
        && reasonableSize();

      // Full members edit content; only the owner changes membership and access.
      // Crit-only and mark-up members cannot change the project document at all.
      allow update: if isMemberOf(resource.data) && reasonableSize()
        && (resource.data.owner == uid()
            || (accessOf(resource.data) == 'full'
                && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['owner', 'roles', 'memberUids', 'access'])));

      // Joining through a valid, unexpired invite: add yourself with the invite's role, nothing else.
      allow update: if signedIn() && !isMemberOf(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roles', 'memberUids', 'members', 'joinCode', 'access'])
        && request.resource.data.get('access', {}).diff(resource.data.get('access', {})).affectedKeys().hasOnly([uid()])
        && request.resource.data.get('access', {}).get(uid(), 'full') == get(/databases/$(database)/documents/invites/$(request.resource.data.joinCode)).data.get('access', 'full')
        && get(/databases/$(database)/documents/invites/$(request.resource.data.joinCode)).data.projectId == projectId
        && get(/databases/$(database)/documents/invites/$(request.resource.data.joinCode)).data.expiresAt > request.time.toMillis()
        && request.resource.data.roles[uid()] == get(/databases/$(database)/documents/invites/$(request.resource.data.joinCode)).data.role
        && request.resource.data.memberUids.hasAll(resource.data.memberUids)
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
        && request.resource.data.memberUids.hasAny([uid()]);

      // Leaving: a member who is not the owner removes themselves, and nothing else.
      allow update: if isMemberOf(resource.data) && resource.data.owner != uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roles', 'memberUids', 'members', 'access'])
        && !(uid() in request.resource.data.memberUids)
        && resource.data.memberUids.hasAll(request.resource.data.memberUids)
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
        && request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly([uid()])
        && request.resource.data.get('access', {}).diff(resource.data.get('access', {})).affectedKeys().hasOnly([uid()]);

      allow delete: if signedIn() && resource.data.owner == uid();

      match /revisions/{revisionId} {
        allow read: if projectMember(projectId);
        allow create: if projectFullMember(projectId) && reasonableSize();
        allow update: if false;
        allow delete: if ownerDeleting(projectId);
      }

      match /messages/{messageId} {
        allow read: if projectMember(projectId);
        allow create: if projectMember(projectId)
          && request.resource.data.text is string
          && request.resource.data.text.size() < 4000
          && reasonableSize();
        // Only the project owner (the person who invites) resolves feedback; the author may erase
        // their marks or correct their text.
        allow update: if projectMember(projectId)
          && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved']) && projectOwner(projectId))
              || ((resource.data.authorId == uid() || projectFullMember(projectId)) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['erased']))
              || (resource.data.authorId == uid()
                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'mentions', 'editedAt'])
                  && request.resource.data.text is string
                  && request.resource.data.text.size() > 0
                  && request.resource.data.text.size() < 4000));
        // Only the person who sent a message can delete it (or the owner, while deleting the
        // whole project because they are deleting their account).
        allow delete: if (projectMember(projectId) && resource.data.authorId == uid()) || ownerDeleting(projectId);
      }

      // Walking figures: one small record per tab, "<uid>__<tab>".
      match /walk/{walkId} {
        allow read: if projectMember(projectId);
        allow write: if projectMember(projectId) && walkId.matches(uid() + '__[a-z0-9]+');
        allow delete: if ownerDeleting(projectId);
      }

      // One presence record per browser tab: "<uid>__<tab>" (older clients used "<uid>").
      match /presence/{memberId} {
        allow read: if projectMember(projectId);
        allow write: if projectMember(projectId) && (memberId == uid() || memberId.matches(uid() + '__[a-z0-9]+'));
        allow delete: if ownerDeleting(projectId);
      }

      // Hybrid-inference telemetry: metadata only (request type, source, latency, tokens).
      match /aiEvents/{eventId} {
        allow read: if projectMember(projectId);
        allow create: if projectMember(projectId)
          && request.resource.data.uid == uid()
          && request.resource.data.source in ['on_device', 'in_cloud', 'heuristic', 'blocked', 'error'];
        allow update: if false;
        allow delete: if (projectMember(projectId) && resource.data.uid == uid()) || ownerDeleting(projectId);
      }
    }
  }
}
